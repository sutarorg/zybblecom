# Zybble deploys as ONE Vercel project: the Vite frontend plus the
# serverless API in api/. Nothing below is needed at build time.
node_modules
dist
supabase
# Ignore the directory's *contents* (not the directory itself) so the one
# build-time guard that `npm run build` runs can be re-included below —
# gitignore semantics cannot un-ignore a file inside an ignored directory.
scripts/*
!scripts/verify-api-emit.mjs
worker
.github
.env
.env.*
!.env.example
