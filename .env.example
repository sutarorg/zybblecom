# Set to the canonical production origin before launch.
SITE_URL=https://zybble.com

# Enable only if the ingress strips and overwrites x-vercel-ip-country.
# Vercel deployment enables this automatically. Otherwise the site uses USD.
PRICING_COUNTRY_HEADER=1

# Optional: show the interruption state on /maintenance. This does not gate the site.
ZYBBLE_MAINTENANCE=1

# Configure together to enable account operations. Exact scheme/host/port, no trailing slash.
# HTTP is allowed only on localhost or 127.0.0.1. Use https://zybble.com in Production.
APP_ORIGIN=http://localhost:3000
# Public Vercel integration aliases NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are also accepted for these two settings.
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AUTH_STATE_SECRET=

# Explicit staging-only opt-in. Live mode is not implemented.
DODO_MODE=test_mode
DODO_CHECKOUT_ENABLED=0
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER_USD=
DODO_PRODUCT_CREATOR_USD=
DODO_PRODUCT_STUDIO_USD=
DODO_PRODUCT_STARTER_INR=
DODO_PRODUCT_CREATOR_INR=
DODO_PRODUCT_STUDIO_INR=

# Private R2 bucket used for verified, archived clips (no public bucket URL).
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Reads known jobs and verifies webhook receipts; paid submission is not enabled.
CLIPSDK_API_KEY=
CLIPSDK_WEBHOOK_SECRET=

# Optional contact email delivery. Use an approved staging mailbox in Preview.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=tejassutar.business@gmail.com

# Optional separate private R2 avatar bucket; use Object Read & Write for this bucket only.
R2_AVATAR_BUCKET_NAME=
R2_AVATAR_ACCESS_KEY_ID=
R2_AVATAR_SECRET_ACCESS_KEY=
