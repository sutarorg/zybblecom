# --- Required: Supabase Postgres -------------------------------------
# Supabase Dashboard → your project → Connect → ORMs / "Connection string".
# Use the TRANSACTION POOLER (port 6543) for Vercel; append the flag below.
# Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Force TLS on/off if your host needs it ("require" | "disable").
# Leave unset — remote hosts get TLS automatically, localhost does not.
# DATABASE_SSL=""

# --- Google OAuth (optional but recommended) ------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Without these, the "Continue with Google" button shows a friendly
# "not configured" message; email/password auth works on its own either way.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Canonical origin of your deployment, no trailing slash.
# Used to build the OAuth redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Locally:     http://localhost:3000
# Production:  https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cloudflare R2 course storage (optional) -------------------------
# Cloudflare Dashboard → R2 Object Storage.
# Without these, upload buttons explain that storage isn't configured and
# creators can still paste external file URLs.
R2_ACCOUNT_ID=""            # R2 Overview → Account ID
R2_ACCESS_KEY_ID=""         # R2 → API → Manage API Tokens → Access Key ID
R2_SECRET_ACCESS_KEY=""     # shown once when the token is created
R2_BUCKET="zybble-courses"  # your bucket name
R2_PUBLIC_BASE_URL=""       # bucket public r2.dev URL or custom domain,
                            # e.g. https://pub-xxxx.r2.dev  (no trailing slash)

# --- Razorpay paid checkout (optional) -------------------------------
# Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Optional --------------------------------------------------------
# Whoever signs up with this email becomes the platform admin.
ADMIN_EMAIL="admin@zybble.com"

# "true" behind HTTPS in production so sessions only go over TLS.
APP_SECURE_COOKIES="false"
