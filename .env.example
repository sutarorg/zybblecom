# ══════════════════════════════════════════════════════════════════════════
#  ZYBBLE — environment variable template
#  1. cp .env.example .env          (local development)
#  2. Or paste these into Vercel → Project → Settings → Environment Variables
#  Full click-by-click instructions for every value: see README.md §3
# ══════════════════════════════════════════════════════════════════════════

# ── Database (required) ─────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS…).
# Neon example: postgresql://user:pass@ep-xxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Sessions (required in production) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── App URL (required for Google OAuth in production) ───────────────────────
# Public origin, no trailing slash. e.g. https://zybble.com or https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# ── Razorpay payments (leave EMPTY to run in built-in TEST MODE) ────────────
# Razorpay Dashboard → Settings → API Keys → Generate Key   (README §3.4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard → Settings → Webhooks → your webhook secret  (README §3.5)
RAZORPAY_WEBHOOK_SECRET=

# ── RazorpayX payouts — account funding creator settlements  (README §3.6) ──
# Empty = payouts are simulated (test mode)
RAZORPAYX_ACCOUNT_NUMBER=

# ── Google sign-in (optional)  (README §3.7) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Settlement scheduler ────────────────────────────────────────────────────
# Protects /api/cron/settle. On Vercel this is REQUIRED — Vercel Cron
# automatically sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -base64 24
CRON_SECRET=

# Timezone for the built-in 16:00 settlement run (non-Vercel hosts; IANA name)
SETTLEMENT_TZ=Asia/Kolkata

# ── Seeding ─────────────────────────────────────────────────────────────────
# The admin account is always created on first boot.
ADMIN_NAME=Zybble Admin
ADMIN_EMAIL=admin@zybble.com
ADMIN_PASSWORD=admin12345

# Set to "false" in production to skip demo creator/buyer/courses/orders.
SEED_DEMO=true
