# Set to the canonical production origin before launch.
SITE_URL=https://zybble.com

# Enable only if the ingress strips and overwrites x-vercel-ip-country.
# Vercel deployment enables this automatically. Otherwise the site uses USD.
# PRICING_COUNTRY_HEADER=1

# Optional: show the interruption state on /maintenance. This does not gate the site.
# ZYBBLE_MAINTENANCE=1

# Configure together to enable account operations. Exact scheme/host/port, no trailing slash.
# APP_ORIGIN=http://localhost:3000
# SUPABASE_URL=http://localhost:54321
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# AUTH_STATE_SECRET= (independent random secret, at least 32 characters)

# Explicit staging-only opt-in. Live mode is not implemented.
# DODO_MODE=test_mode
# DODO_CHECKOUT_ENABLED=0
# DODO_PAYMENTS_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_PRODUCT_STARTER_USD=
# DODO_PRODUCT_CREATOR_USD=
# DODO_PRODUCT_STUDIO_USD=
# DODO_PRODUCT_STARTER_INR=
# DODO_PRODUCT_CREATOR_INR=
# DODO_PRODUCT_STUDIO_INR=
