# ════════════════════════════════════════════════════════════
# Zybble — production environment
# ════════════════════════════════════════════════════════════

# ——— Frontend (public, safe to ship to the browser) ———
# Supabase Auth runs in the browser with the anon key; all
# privileged work goes through the API below.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://api.yourdomain.com

# ——— Supabase (server-only) ———
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ——— OpenAI (server-side only, never shipped to the client) ———
OPENAI_API_KEY=
OPENAI_MODEL=o4-mini

# ——— Razorpay subscriptions (USD) ———
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ——— SMTP credential encryption (AES-256-GCM, 64 hex chars = 32 bytes) ———
# Generate with: openssl rand -hex 32
SMTP_ENCRYPTION_KEY=

# ——— App ———
APP_URL=https://zybble.com
NEXT_PUBLIC_APP_URL=

# ——— Workers ———
# Shared secret between the API and the Python scraper worker
# and inbound-email providers (SendGrid/Mailgun inbound parse).
WORKER_SECRET=
