# ════════════════════════════════════════════════════════════
# Zybble — single application (one Vercel project)
#
# There is no separate API, mailer or scraper service. Set these
# in Vercel → Project → Settings → Environment Variables.
# ════════════════════════════════════════════════════════════

# ——— Frontend (public; safe to expose in the browser bundle) ———
# Supabase Auth runs client-side with the anon key. The API is
# same-origin at /api, so there is no API URL to configure.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ——— Supabase (server-only) ———
# IMPORTANT: SUPABASE_URL is the Project URL — https://xyz.supabase.co
# Do NOT paste the /rest/v1/ endpoint; the API strips it defensively, but the
# bare Project URL is the correct value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ——— OpenAI (server-only) ———
OPENAI_API_KEY=
OPENAI_MODEL=o4-mini

# ——— Lead provider ———
# "worker" (default) = Selenium scraper on Railway, no Google Maps API key.
# "places" = emergency serverless fallback only (NOT used by default).
LEAD_PROVIDER=worker

# Shared secret between Vercel and the Railway scraper worker.
# Generate: openssl rand -hex 32 — must be identical in both places.
SCRAPER_WORKER_SECRET=

# ——— Railway worker only (set in Railway → Variables, NOT here) ———
# ZYBBLE_APP_URL=https://your-zybble-domain.com
# SCRAPER_WORKER_SECRET=<same value as above>
# SCRAPER_CONCURRENCY=2
# SCRAPER_POLL_SECONDS=5
# SCRAPER_JOB_TIMEOUT_SECONDS=1200

# Required only if you explicitly switch LEAD_PROVIDER=places.
GOOGLE_MAPS_API_KEY=

# ——— Razorpay subscriptions, USD (server-only) ———
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ——— SMTP credential encryption (AES-256-GCM, 64 hex chars) ———
# Generate with: openssl rand -hex 32
SMTP_ENCRYPTION_KEY=

# ——— Background processing (server-only) ———
# Authenticates Vercel Cron calls to /api/cron/tick.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ——— Optional ———
# Public site URL. Vercel provides this automatically in production;
# set it explicitly when using a custom domain.
APP_URL=
# Extra browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=
