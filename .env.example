# --- Required -------------------------------------------------------
# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, RDS, local)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# --- Google OAuth (optional but recommended) ------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Without these, the "Continue with Google" button shows a friendly
# "not configured" message; email/password auth works on its own either way.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Canonical origin of your deployment, no trailing slash.
# Used to build the exact OAuth redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Locally:     http://localhost:3000
# Production:  https://your-app.vercel.app
# If unset, the callback origin is derived from the incoming request.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Razorpay paid checkout (optional) -------------------------------
# Razorpay Dashboard → Settings → API Keys.
# Without these, free-course enrollment works and paid checkout
# returns a clear "payments not configured" state.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Optional --------------------------------------------------------
# Whoever signs up with this email becomes the platform admin.
ADMIN_EMAIL="admin@zybble.com"

# "true" behind HTTPS in production so sessions only go over TLS.
APP_SECURE_COOKIES="false"
