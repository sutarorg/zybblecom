# ════════════════════════════════════════════════════════════
# Zybble — single application (one Vercel project)
#
# There is no separate API, mailer or scraper service. Set these
# in Vercel → Project → Settings → Environment Variables.
# ════════════════════════════════════════════════════════════

# ——— Frontend (public; safe to expose in the browser bundle) ———
# Supabase Auth runs client-side with the anon key. The API is
# same-origin at /api, so there is no API URL to configure.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ——— Supabase (server-only) ———
# IMPORTANT: SUPABASE_URL is the Project URL — https://xyz.supabase.co
# Do NOT paste the /rest/v1/ endpoint; the API strips it defensively, but the
# bare Project URL is the correct value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ——— OpenAI (server-only) ———
OPENAI_API_KEY=
OPENAI_MODEL=o4-mini

# ——— Lead Finder ———
# Discovery runs in the Railway scraper worker, which drives real Google Maps
# through the open-source engine gosom/google-maps-scraper — pinned in
# worker/vendor/engine.json, built from source by worker/Dockerfile and run as a
# child process by worker/gmaps_engine.py. No Google Maps API key, Places API or
# Geocoding API is used anywhere, so there is nothing else to configure here.
#
# Shared secret between Vercel and the Railway scraper worker.
# Generate: openssl rand -hex 32 — must be identical in both places.
SCRAPER_WORKER_SECRET=

# ——— Railway worker only (set in Railway → Variables, NOT here) ———
# ZYBBLE_APP_URL=https://your-zybble-domain.com
# SCRAPER_WORKER_SECRET=<same value as above>
# SCRAPER_CONCURRENCY=2                 # job slices this worker runs in parallel
# SCRAPER_POLL_SECONDS=5
# SCRAPER_JOB_TIMEOUT_SECONDS=1200      # engine budget per job slice; the job resumes afterwards
# SCRAPER_EMAIL_BUDGET_SECONDS=600
# SCRAPER_MAX_TILES=36                  # viewports swept to cover the location
# SCRAPER_MAX_ATTEMPTS=6                # bounded slices a broad search may use
# SCRAPER_BATCH_SIZE=5                  # leads per crash-safe batch
# SCRAPER_TARGETS_PER_RUN=6             # viewports per engine run; lower = finer resume points
#
# Scraping engine (gosom/google-maps-scraper). The defaults below are tuned for a
# 1 vCPU / 1 GB Railway container — raise them only with more CPU and RAM, since
# every Chromium page costs both.
# GOOGLE_MAPS_SCRAPER_BIN=              # absolute path to the binary; auto-detected on PATH and in /usr/local/bin
# SCRAPER_ENGINE_BIN=                   # alias of GOOGLE_MAPS_SCRAPER_BIN
# SCRAPER_ENGINE_CONCURRENCY=2          # -c: searches the engine runs at once
# SCRAPER_ENGINE_BROWSER_POOL=1         # -browser-pool-size: Chromium contexts (0 = let the engine derive it)
# SCRAPER_ENGINE_PAGES_PER_BROWSER=2    # -pages-per-browser: tabs per Chromium context
# SCRAPER_ENGINE_DEPTH=10               # -depth: scroll depth per viewport (raised automatically when a slice needs more)
# SCRAPER_ENGINE_LANG=en                # -lang: Google interface language, e.g. de, fr, hi
# SCRAPER_ENGINE_INACTIVITY=3m          # -exit-on-inactivity: abandon a wedged browser session after this idle time
# SCRAPER_ENGINE_EXTRACT_EMAIL=0        # -email: let the engine read addresses off business websites
#                                       #        (Zybble still verifies syntax and DNS MX before storing one)
# SCRAPER_ENGINE_DISABLE_PAGE_REUSE=0   # -disable-page-reuse: a fresh tab per viewport (slower, more resilient)
# SCRAPER_ENGINE_PROXIES_FILE=          # -proxies-file: one proxy URL per line, if you route the engine through proxies
# SCRAPER_ENGINE_EXTRA_ARGS=            # passed through verbatim, e.g. "-zoom 16"
# SCRAPER_ENGINE_POLL_INTERVAL=0.25     # seconds between reads of the engine's results stream
# SCRAPER_ENGINE_STOP_GRACE=15          # seconds a stopped engine gets before SIGKILL
# SCRAPER_ENGINE_WORKDIR=               # where per-run input/results files go (default: a temp dir)
# SCRAPER_ENGINE_KEEP_WORKDIR=0         # keep them after a run, for debugging
# DISABLE_TELEMETRY=1                   # forced by the worker itself; no usage data ever leaves the container

# ——— Razorpay subscriptions, USD (server-only) ———
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ——— SMTP credential encryption (AES-256-GCM, 64 hex chars) ———
# Generate with: openssl rand -hex 32
SMTP_ENCRYPTION_KEY=

# ——— Background processing (server-only) ———
# Authenticates Vercel Cron calls to /api/cron/tick.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ——— Optional ———
# Public site URL. Vercel provides this automatically in production;
# set it explicitly when using a custom domain.
APP_URL=
# Extra browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=
