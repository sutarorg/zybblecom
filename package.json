{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "dev:web": "vite",
    "build": "tsc --noEmit && node scripts/verify-api-emit.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:api": "node scripts/verify-api-emit.mjs",
    "test": "npm run test:api && npm run test:leadfinder && npm run verify:no-google && npm run test:worker && npm run verify:migrations",
    "e2e": "node scripts/e2e-production.mjs",
    "test:api": "node --experimental-strip-types scripts/e2e-search-fix.mjs",
    "test:leadfinder": "node --experimental-strip-types scripts/e2e-lead-finder.mjs",
    "test:worker": "python3 worker/run_tests.py",
    "verify:no-google": "node scripts/verify-no-google-maps.mjs",
    "verify:migrations": "python3 scripts/verify-migrations.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@types/nodemailer": "^8.0.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "2.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "nodemailer": "^10.0.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
